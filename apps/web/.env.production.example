# Copy to the ignored repository-root .local/production.env.
# Deployment tooling reads that file explicitly. Next.js must not auto-load it locally.
# Set AUTH_URL to the confirmed HTTPS production origin before enabling requests.
AUTH_URL=
AUTH_SECRET=
# User choice: reuse the personal Workbench OAuth app with both callbacks.
# Keep a distinct production AUTH_SECRET and preserve the local callback.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
WORKBENCH_ALLOWED_GITHUB_IDS=26425317
DATABASE_URL=
GROQ_API_KEY=
WORKBENCH_PROVIDER=groq
WORKBENCH_MODEL=openai/gpt-oss-120b
WORKBENCH_DAILY_USER_USD=1
WORKBENCH_DAILY_APP_USD=5
WORKBENCH_LIVE_ENABLED=false
ENABLE_EXPERIMENTAL_COREPACK=1
