# Copy to .env.local in this application directory. Never commit real values.
# The parent workspace .env is unrelated and must not be copied or loaded.
AUTH_URL=http://127.0.0.1:3135
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub account IDs, not usernames. Personal jaskevs account only.
WORKBENCH_ALLOWED_GITHUB_IDS=26425317
DATABASE_URL=
# Only the selected provider needs a key. Keep Groq on its Free account plan.
GROQ_API_KEY=
OPENAI_API_KEY=
WORKBENCH_PROVIDER=groq
WORKBENCH_MODEL=openai/gpt-oss-120b
WORKBENCH_DAILY_USER_USD=1
WORKBENCH_DAILY_APP_USD=5
# Keep false until service configuration and the database migration are complete.
WORKBENCH_LIVE_ENABLED=false
